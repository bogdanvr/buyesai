# Merge these settings into the existing .env after HTTPS is configured.
# This is a partial example, not a replacement for database/API credentials.
DEBUG=False
HTTP_PORT=8080
DJANGO_ALLOWED_HOSTS=buyes.pro,localhost,127.0.0.1
